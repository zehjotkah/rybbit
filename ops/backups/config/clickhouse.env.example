# Copy to /etc/rybbit-backup.env on the standalone ClickHouse host and chmod 600.

BACKUP_HOST=clickhouse

CLICKHOUSE_CONTAINER=clickhouse
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_BACKUP_MODE=local
CLICKHOUSE_BACKUP_RECEIVE_TIMEOUT=21600
CLICKHOUSE_BACKUP_DISK=backups
CLICKHOUSE_LOCAL_BACKUP_ROOT=/var/backups/rybbit/clickhouse
CLICKHOUSE_KEEP_LOCAL_BACKUP=false

# The same completed native snapshot is copied to both providers. Configure
# these names in root's /root/.config/rclone/rclone.conf.
CLICKHOUSE_RCLONE_REMOTES=hetzner:clickhouse-backups,b2:rybbit-db-backups/clickhouse/analytics

# Hetzner does not have B2 lifecycle rules, so prune it from the host. Do not
# include the Object-Locked B2 remote here; let B2 lifecycle rules expire it.
CLICKHOUSE_PRUNE_REMOTES=hetzner:clickhouse-backups
CLICKHOUSE_REMOTE_RETENTION_DAYS=14

# CLICKHOUSE_SUCCESS_URL=
# CLICKHOUSE_FAILURE_URL=
